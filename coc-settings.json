{
    // 1. coc: 使用类似vscode的配置
    "coc.preferences.formatOnSave": true,
    // 2. coc-vetur配置: https://www.npmjs.com/package/coc-vetur
    "vetur.ignoreProjectWarning": true,
    "vetur.validation.script": false,
    // 3. javascript: 见https://juejin.cn/post/7077102548640858125, 更改jsconfig.json
    "javascript.suggestionActions.enabled": false,
    "typescript.suggestionActions.enabled": false,
    // 4. html, 见https://github.com/neoclide/coc-html
    "html.filetypes": [
        "html",
        "handlebars",
        "htmldjango",
        "blade"
    ],
    // jedi configure
    "jedi.enable": true,
    // Language: 各种语言服务器配置, 其支持三种模式配置: module, executable, socket, 下面的go是第二种
    "languageserver": {
        "golang": {
            "command": "gopls",
            "rootPatterns": [
                "go.mod",
                ".git/"
            ],
            "filetypes": [
                "go"
            ]
        }
    }
}
